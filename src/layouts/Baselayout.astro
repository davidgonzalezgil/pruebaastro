---
import Card from "../components/Card.astro";
import Menu from "../components/Menu.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mi Web en Astro</title>
    </head>
    <body>
        <header>
            <Menu />
        </header>

        <main class="container">
            <Card>
                <slot />
            </Card>
        </main>
    </body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
        background: radial-gradient(circle at top, #0f172a 0%, #030712 100%);
        color: #f1f5f9;
        line-height: 1.7;
        padding: 2.5rem 1rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Margen entre párrafos y encabezados */
    p,
    h1,
    h2,
    h3,
    h4,
    ul,
    ol {
        margin-bottom: 1rem;
    }

    h1,
    h2,
    h3,
    h4 {
        line-height: 1.3;
        color: #ffffff;
        font-weight: 700;
        letter-spacing: -0.02em;
        text-align: center;
    }

    header {
        width: fit-content;
        max-width: 100%;
        margin: 0 auto 2rem auto;
        padding: 0.25rem; /* Se respeta el padding original del menú */
    }

    .container {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }

    /* Estilo de caja (fondo, borde y sombra) compartido */
    header,
    .container > * {
        background: linear-gradient(145deg, #1e293b, #0f172a);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        box-shadow:
            0 10px 30px -10px rgba(0, 0, 0, 0.5),
            0 0 15px rgba(56, 189, 248, 0.03);
        backdrop-filter: blur(8px);
    }

    /* El espacio interno amplio se aplica ÚNICAMENTE a la tarjeta de datos */
    .container > * {
        padding: 2rem;
    }

    /* --- ESTILOS PARA LA TABLA DE PRODUCTOS --- */
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.5rem;
    }

    th,
    td {
        padding: 0.75rem 1rem;
        text-align: left;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    th {
        color: #38bdf8;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
    }

    td:last-child,
    th:last-child {
        text-align: right;
    }

    tr:hover td {
        background-color: rgba(255, 255, 255, 0.03);
    }

    /* Enlaces estilizados */
    a {
        color: #38bdf8;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    a:hover {
        color: #7dd3fc;
        text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
    }

    ::selection {
        background-color: #0284c7;
        color: #ffffff;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    /* Alinea ID y Nombre a la izquierda */
    th,
    td {
        padding: 0.75rem 1rem;
        text-align: left;
    }

    /* Alinea la cabecera 'Precio' y sus valores a la derecha */
    th:last-child,
    td:last-child {
        text-align: right;
    }
</style>
