---
import Card from "../components/Card.astro";
import Menu from "../components/Menu.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mi Web en Astro</title>
    </head>
    <body>
        <header>
            <Menu />
        </header>

        <main class="container">
            <Card>
                <slot />
            </Card>
        </main>
    </body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #0a0f1d; /* Fondo azul noche muy oscuro */
        color: #e2e8f0; /* Texto azul/blanco muy claro */
        padding: 2rem 1rem;
    }

    header {
        width: fit-content; /* El fondo azul se alarga justo al tamaño de los botones */
        max-width: 100%; /* No se sale del ancho de la pantalla */
        margin: 0 auto 1.5rem auto; /* Lo centra perfectamente en la pantalla */
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
    }

    /* --- CAMBIO DE MARCOS / CUADROS DE NAVEGACIÓN Y CONTENIDO --- */
    header, 
    .container > * {
        background-color: #1e293b; /* Azul marino/pizarra para el fondo del cuadro */
        border: 1px solid #334155; /* Borde azul grisáceo tenue */
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4); /* Sombra elegante para dar profundidad */
    }

    /* Enlaces generales */
    a {
        color: #38bdf8; /* Azul cian eléctrico */
        text-decoration: none;
        transition: color 0.2s ease;
    }

    a:hover {
        color: #7dd3fc;
        text-decoration: underline;
    }

    ::selection {
        background-color: #0284c7;
        color: #ffffff;
    }
</style>