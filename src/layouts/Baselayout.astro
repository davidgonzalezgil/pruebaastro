---
import Card from "../components/Card.astro";
import Menu from "../components/Menu.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mi Web en Astro</title>
    </head>
    <body>
        <header>
            <Menu />
        </header>

        <main class="container">
            <Card>
                <slot />
            </Card>
        </main>
    </body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
        background: radial-gradient(
            circle at top,
            #0f172a 0%,
            #030712 100%
        ); /* Degradado sutil de fondo */
        color: #f1f5f9;
        line-height: 1.7; /* Mayor espacio de lectura entre líneas */
        padding: 2.5rem 1rem;
        min-height: 100vh;
    }

    /* Margen entre párrafos, listas y encabezados en todo el sitio */
    p,
    h1,
    h2,
    h3,
    h4,
    ul,
    ol,
    div {
        margin-bottom: 0.85rem;
    }

    p:last-child,
    ul:last-child,
    ol:last-child {
        margin-bottom: 0;
    }

    /* Estilo general para encabezados */
    h1,
    h2,
    h3,
    h4 {
        line-height: 1.3;
        color: #ffffff;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-top: 0.5rem;
    }

    header {
        width: fit-content;
        max-width: 100%;
        margin: 0 auto 2rem auto;
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
    }

    /* Targetas y contenedores con un diseño de bordes y sombras más pulido */
    header,
    .container > * {
        background: linear-gradient(145deg, #1e293b, #0f172a);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        box-shadow:
            0 10px 30px -10px rgba(0, 0, 0, 0.5),
            0 0 15px rgba(56, 189, 248, 0.03);
        backdrop-filter: blur(8px);
        padding: 0.25rem;
    }

    /* Enlaces estilizados */
    a {
        color: #38bdf8;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    a:hover {
        color: #7dd3fc;
        text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
    }

    ::selection {
        background-color: #0284c7;
        color: #ffffff;
    }
</style>
