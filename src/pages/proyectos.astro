---
import { getCollection } from "astro:content";
import Baselayout from "../layouts/Baselayout.astro";

const proyectos = await getCollection("proyectos");
---

<Baselayout>
    <h1>Lista de todos los proyectos</h1>

    <div class="lista-proyectos">
        {proyectos.map((proyecto) => (
            <a href={`/proyectos/${proyecto.id}`} class="tarjeta-proyecto">
                {proyecto.data.imagen && (
                    <img 
                        src={proyecto.data.imagen} 
                        alt={proyecto.data.titulo} 
                        class="imagen-miniatura" 
                    />
                )}
                <span class="titulo-proyecto">{proyecto.data.titulo}</span>
            </a>
        ))}
    </div>
</Baselayout>

<style>
    .lista-proyectos {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .tarjeta-proyecto {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        padding: 0.75rem 1rem;
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        text-decoration: none;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .tarjeta-proyecto:hover {
        background-color: #334155;
        transform: translateX(4px);
    }

    .imagen-miniatura {
        width: 70px;
        height: 50px;
        object-fit: cover;
        border-radius: 6px;
    }

    .titulo-proyecto {
        color: #38bdf8;
        font-weight: 600;
        font-size: 1.1rem;
    }
</style>