---
import Baselayout from "../layouts/Baselayout.astro";
import { getAllProducts } from "../lib/db.js";
export const prerender = false

let productos = []
let error = false

try {
    productos = await getAllProducts()
} catch (err) {
    console.log("Error al obtener los productos:", err);
    error = true 
    Astro.response.status = 503
}
---

<Baselayout>

<h1>Lista de productos guardados en BD</h1>

{error && <p style="color: red;">Ocurrió un error al cargar los productos.</p>}

<!-- Formulario necesario para la función 'añadir' del script -->
<form class="crear-prod">
    <input type="text" name="nombre" placeholder="Nombre del producto" required />
    <input type="number" step="0.01" name="precio" placeholder="Precio" required />
    <button type="submit">Añadir</button>
</form>

<div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>NOMBRE</th>
                <th>PRECIO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            {productos.map((producto) => (
                <tr>
                    <td>{producto.id}</td>
                    <td>{producto.nombre}</td>
                    <td>{producto.precio} €</td>
                    <td>
                        <!-- Botón necesario para la función 'borrar' del script -->
                        <button class="boton-borrar" data-id={producto.id}>Borrar</button>
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
</div>

</Baselayout>

<script>
    import { actions } from "astro:actions";

    // Añadir producto con su precio
    document.addEventListener("submit", añadir)
    async function añadir(event) {
        if(!event.target.classList.contains("crear-prod")) return;

        event.preventDefault();
        
        const formData = new FormData(event.target);
        const nombre = String(formData.get("nombre"));
        const precio = Number(formData.get("precio"));
        await actions.productAdd({nombre:nombre, precio:precio})
        window.location.reload();
    }

    // Borrar producto por id
    document.addEventListener("click", borrar)
    async function borrar(event) {
        const target = event.target.closest(".boton-borrar");
        if(!target) return;

        const id_borrar = Number(target.dataset.id)
        await actions.productDelete({id:id_borrar})
        window.location.reload();
    }
</script>